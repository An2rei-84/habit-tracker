# Production Environment Variables Template
# Copy this to .env on the server or configure in GitHub Secrets

# ============================================
# DJANGO SETTINGS
# ============================================
SECRET_KEY=CHANGE_THIS_TO_SECURE_RANDOM_STRING
DEBUG=False
ALLOWED_HOSTS=your-server-ip,your-domain.com

# ============================================
# DATABASE (PostgreSQL)
# ============================================
DB_ENGINE=django.db.backends.postgresql
DB_NAME=habit_tracker
DB_USER=postgres
DB_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD
DB_HOST=db
DB_PORT=5432

# ============================================
# CELERY (Redis)
# ============================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ============================================
# TELEGRAM BOT
# ============================================
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-from-botfather

# ============================================
# CORS SETTINGS
# ============================================
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

# ============================================
# SECURITY NOTES
# ============================================
# 1. Generate SECRET_KEY with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# 2. Use strong password for DB_PASSWORD (min 32 chars with symbols)
# 3. Get TELEGRAM_BOT_TOKEN from @BotFather in Telegram
# 4. Update ALLOWED_HOSTS with your actual domain(s)
